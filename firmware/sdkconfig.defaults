# Hedef
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# LP çekirdek (ekranın 1 Hz EXTCOMIN darbesi uykuda da devam eder)
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# Güç: düşük frekans, gereksiz loglar kapalı
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=y

# Konsol USB üzerinden (UART0 TX = D6 boş kalır)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Güvenlik ağları
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_BROWNOUT_DET=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Daha küçük ikili = uykudan daha hızlı açılış
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
